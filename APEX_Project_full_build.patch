+            JOIN users u ON u.id = q.user_id";
+    if ($moduleFilter !== null) {
+        $sql .= " WHERE q.module_number = ?";
+    }
+    $sql .= " ORDER BY q.attempted_at DESC LIMIT 500";
+
+    $stmt = $db->prepare($sql);
+    if ($moduleFilter !== null) {
+        $stmt->bind_param('i', $moduleFilter);
+    }
+    $stmt->execute();
+    $rows = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
+    $stmt->close();
+    return $rows;
+}
